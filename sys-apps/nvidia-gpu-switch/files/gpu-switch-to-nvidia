#!/bin/bash
# Switch from nouveau to nvidia for display manager
# nouveau handles boot splash (plymouth), nvidia handles X/3D

echo "gpu-switch: Unloading nouveau and dependencies..."

# Unload nouveau and all dependent modules
modprobe -rf nouveau 2>/dev/null
modprobe -rf drm_ttm_helper 2>/dev/null
modprobe -rf ttm 2>/dev/null
modprobe -rf drm_gpuvm 2>/dev/null
modprobe -rf gpu_sched 2>/dev/null
modprobe -rf drm_exec 2>/dev/null
modprobe -rf drm_display_helper 2>/dev/null
modprobe -rf drm_kms_helper 2>/dev/null
modprobe -rf drm 2>/dev/null
sleep 1

# Verify nouveau is gone
if lsmod | grep -q nouveau; then
    echo "gpu-switch: WARNING - nouveau still loaded, trying rmmod..."
    rmmod nouveau 2>/dev/null || true
    sleep 1
fi

echo "gpu-switch: Loading nvidia..."
modprobe nvidia 2>/dev/null || true

# Apply GLVND fix if needed (nvidia 340.108 predates GLVND)
if [[ -f /usr/lib64/nvidia/libGL.so ]]; then
    md5_current=$(md5sum /usr/lib64/libGLX.so.0.0.0 2>/dev/null | cut -d' ' -f1)
    md5_nvidia=$(md5sum /usr/lib64/nvidia/libGL.so 2>/dev/null | cut -d' ' -f1)
    if [[ "$md5_current" != "$md5_nvidia" ]]; then
        echo "gpu-switch: Applying GLVND bypass..."
        cp /usr/lib64/nvidia/libGL.so /usr/lib64/libGLX.so.0.0.0
    fi
fi

echo "gpu-switch: Done. nvidia loaded for display manager."
