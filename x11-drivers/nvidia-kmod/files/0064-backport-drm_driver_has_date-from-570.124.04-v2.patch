+++ work-b/kernel/nv-drm.c	2026-08-06 00:01:47.349684039 -0000
@@ -548,7 +548,11 @@
 
     .name = "nvidia-drm",
     .desc = "NVIDIA DRM driver",
-    .date = "20150116",
+
+#if defined(NV_DRM_DRIVER_HAS_DATE)
+     .date = "20150116",
+#endif
+
     .major = 0,
     .minor = 0,
     .patchlevel = 0,
