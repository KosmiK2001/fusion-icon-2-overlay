+++ work-b/kernel/Makefile	2026-08-05 23:59:56.906949026 -0000
@@ -168,6 +168,7 @@
 	drm_device_has_pdev \
 	acpi_bus_get_device \
 	vm_area_struct_has_const_vm_flags \
+	drm_driver_has_date \
 
 #
